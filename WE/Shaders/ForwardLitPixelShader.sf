#include "ForwardLitCommon.sh"

float4 MainPS(FVSOutput PIn) : SV_Target
{
    FMaterialData MaterialData = gMaterialData[gMaterialIndex];
    
    float4 Albedo = gTexture[MaterialData.TextureIndex].Sample(gsamLinearWrap, PIn.TexC) * MaterialData.DiffuseAlbedo;
    
#ifdef ALPHA_TEST
    clip(Albedo.a - 0.1f);
#endif


    
    PIn.NormalW = normalize(PIn.NormalW);
    float3 ToEyeW = gEyePosW - PIn.PosW;
    float distToEye = length(ToEyeW);
    ToEyeW /= distToEye;
    
    float4 Ambient = gAmbientLight * Albedo;
    
    const float Shiniess = 1.0f - MaterialData.Roughness;
    Material Mat = { Albedo, MaterialData.FresnelR0, Shiniess };
    float3 ShadowFactor = 1.0f;
    float4 DirectLight = ComputeLighting(gLights, Mat, PIn.PosW,
        PIn.NormalW, ToEyeW, ShadowFactor
    );
    
    float4 LitColor = Ambient + DirectLight;
    
#ifdef FOG
    float fogAmount = saturate((distToEye - gFogStart) / gFogRange);
	LitColor = lerp(LitColor, gFogColor, fogAmount);
#endif
    
    LitColor.a = Albedo.a;
    return LitColor;
}
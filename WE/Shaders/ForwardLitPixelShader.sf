#include "ForwardLitCommon.sh"

float4 MainPS(FVSOutput PIn) : SV_Target
{
    FMaterialSB MaterialData = gMaterialData[gMaterialIndex];
    
    float3 Albedo = pow(gTexture[MaterialData.AlbedoTextureIndex].Sample(gsamLinearWrap, PIn.TexC).rgb, 2.2); // 감마 보정된 값을 원래대로 돌리기 위해 2.2제곱
    float Metallic = gTexture[MaterialData.MetallicTextureIndex].Sample(gsamLinearWrap, PIn.TexC).r;
    float Roughness = gTexture[MaterialData.RoughneesTextureIndex].Sample(gsamLinearWrap, PIn.TexC).r;
    
#ifdef ALPHA_TEST
    // TODO
    // clip(Albedo.a - 0.1f);
#endif
    
    PIn.NormalW = normalize(PIn.NormalW);
    float3 ToEyeW = gEyePosW - PIn.PosW;
    float distToEye = length(ToEyeW);
    ToEyeW /= distToEye;
    
    float3 F0 = (float3)0.04;
    F0 = lerp(F0, Albedo, Metallic);
    
    float3 Lo = (float3)0.0f;
    
    // DirectionalLight 
    for (int i = 0; i < DIR_LIGHTS_NUM; ++i)
    {
        Lo += ComputeDirectionalLight(gDirectionalLights[i], ToEyeW, Albedo, Metallic, PIn.NormalW, Roughness, F0);
    }
    
    // TODO: AO 적용. float3(1.0f)를 AO로 변경
    float3 Ambient = (float3) 0.03 * Albedo * (float3)1.0f;
    float3 Color = Ambient + Lo;
    Color = Color / (Color + (float3)1.0f);
    Color = pow(Color, (float3)(1.0f / 2.2f));
    
#ifdef FOG
    float fogAmount = saturate((distToEye - gFogStart) / gFogRange);
	Color = lerp(Color, gFogColor, fogAmount);
#endif
    return float4(Color, 1.0f);
}
#include "CubeSkyDiffuseMapCommon.sh"

void DrawSphere(in float3 InPosL, in float4x4 ViewProj, out float3 OutPosL, out float4 OutPosH)
{
    OutPosL = InPosL;
    OutPosH = mul(float4(InPosL, 1.0f), ViewProj);
}

void MainVS(
    float3 InPosL : POSITION,
    out float3 OutPosL : POSITION0,
    out float4 OutPosH : SV_Position
)
{
    DrawSphere(InPosL, gViewProj, OutPosL, OutPosH);
}
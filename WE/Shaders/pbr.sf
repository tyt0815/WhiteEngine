#ifndef PBR_H
#define PBR_H
#include "Common.sh"

float3 FresnelSchlick(float cosTheta, float3 F0)
{
    return F0 + (1.0f - F0) * pow(clamp(1.0f - cosTheta, 0.0f, 1.0f), 5.0f);
}

float DistributionGGX(float3 N, float3 H, float Roughness)
{
    float a = Roughness * Roughness;
    float a2 = a * a;
    float NdotH = max(dot(N, H), 0.0f);
    float NdotH2 = NdotH * NdotH;
    
    float Num = a2;
    float Denom = (NdotH2 * (a2 - 1.0) + 1.0f);
    Denom = PI * Denom * Denom;

    return Num / Denom;
}

float GeometrySchlickGGX(float NdotV, float Roughness)
{
    float r = (Roughness + 1.0);
    float k = (r * r) / 8.0;

    float Num = NdotV;
    float Denom = NdotV * (1.0 - k) + k;
	
    return Num / Denom;
}

float GeometrySmith(float3 N, float3 V, float3 L, float Roughness)
{
    float NdotV = max(dot(N, V), 0.0);
    float NdotL = max(dot(N, L), 0.0);
    float ggx2 = GeometrySchlickGGX(NdotV, Roughness);
    float ggx1 = GeometrySchlickGGX(NdotL, Roughness);
	
    return ggx1 * ggx2;
}

struct FVSInput
{
    float3 PosL : POSITION;
    float3 NormalL : NORMAL;
    float2 TexC : TEXCOORD;
};

struct FVSOutput
{
    float4 PosH : SV_POSITION;
    float3 PosW : POSITION;
    float3 NormalW : NORMAL;
    float2 TexC : TEXCOORD;
};


FVSOutput MainVS(FVSInput VIn)
{
    FVSOutput VOut;
    FMaterialSB MaterialData = gMaterialData[gMaterialIndex];
    
    float4 PosW = mul(float4(VIn.PosL, 1.0f), gWorld);
    VOut.PosW = PosW.xyz;
    VOut.NormalW = mul(VIn.NormalL, (float3x3) gWorld);
    VOut.PosH = mul(PosW, gViewProj);
    VOut.TexC = mul(float4(VIn.TexC, 0.0f, 1.0f), MaterialData.MatTransform).xy;
    return VOut;
}

float4 MainPS(FVSOutput PIn) : SV_Target
{
    FMaterialSB MaterialData = gMaterialData[gMaterialIndex];
    
    float3 Albedo = pow(gTexture[MaterialData.AlbedoTextureIndex].Sample(gsamLinearWrap, PIn.TexC).rgb, 2.2);   // 감마 보정된 값을 원래대로 돌리기 위해 2.2제곱
    float Metallic = gTexture[MaterialData.MetallicTextureIndex].Sample(gsamLinearWrap, PIn.TexC).r;
    float Roughness = gTexture[MaterialData.RoughneesTextureIndex].Sample(gsamLinearWrap, PIn.TexC).r;
    
#ifdef ALPHA_TEST
    // TODO
    // clip(Albedo.a - 0.1f);
#endif
    
    PIn.NormalW = normalize(PIn.NormalW);
    float3 ToEyeW = gEyePosW - PIn.PosW;
    float distToEye = length(ToEyeW);
    ToEyeW /= distToEye;
    
    float3 F0 = float3(0.04);
    F0 = lerp(F0, Albedo, Metallic);
    
    float3 Lo = float3(0.0f);
    // DirectionalLight 
    for (int i = 0; i < DIR_LIGHTS_NUM; ++i)
    {
        // 방사선 계산
        float3 Radiance = gDirectionalLights[i].Color;
        
        // 쿠크-토렌스 brdf
        float3 L = normalize(-gDirectionalLights[i].Direction);
        float3 H = normalize(ToEyeW + L);
        float NDF = DistributionGGX(PIn.NormalW, H, Roughness);
        float G = GeometrySmith(PIn.NormalW, ToEyeW, L, Roughness);
        float F = FresnelSchlick(max(dot(H, ToEyeW), 0.0f), F0);
        
        float3 kS = F;
        float3 kD = float3(1.0f) - kS;
        kD *= 1.0f - Metallic;

        float3 Numerator = NDF * G * F;
        float Denominator = 4.0f * max(dot(PIn.NormalW, ToEyeW), 0.0f) * max(dot(PIn.NormalW, L), 0.0f);
        float3 Specular = Numerator / Denominator;
        
        // 방사선에 Lo 추가
        float NDotL = max(dot(PIn.NormalW, L), 0.0f);
        Lo += (kD * Albedo / PI + Specular) * Radiance * NDotL;
    }
    
    // TODO: AO 적용. float3(1.0f)를 AO로 변경
    float3 Ambient = float3(0.03) * Albedo * float3(1.0f);
    float3 Color = Ambient + Lo;
    
    Color = Color / (Color + float3(1.0f));
    Color = pow(Color, float3(1.0f / 2.2f));
    
#ifdef FOG
    float fogAmount = saturate((distToEye - gFogStart) / gFogRange);
	Color = lerp(Color, gFogColor, fogAmount);
#endif
    
    return float4(Color, 1.0f);
}
#endif
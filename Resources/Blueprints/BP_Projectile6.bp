<AProjectileBase>

    <Configs>
        <Movement InitSpeed = "(0 0 20)" GravityScale = "0" MaxSpeed = "1000"/>
        <LifeCycle Life = "5" />

        <Homing Strategy = "Nearest" HomingRange = "20" HomingTurnRate = "90" TargetTags = "[Alliance]" />
    </Configs>

    <Components>
        <Mesh Name = "Body" Asset = "SM_ScuffedGoldBox">
            <Collision Name = "BoxCollision" Type = "Box" Extent = "(1 1 1)" Damage = "250" Delay = "0.5" TargetTags = "Alliance"/>
        </Mesh>
    </Components>

    <Events>
        <OnHit>
            <Destroy/>
        </OnHit>
    </Events>

</AProjectileBase>
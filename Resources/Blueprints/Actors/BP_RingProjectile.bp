<AProjectileBase>

    <Components>
        <WSplineCollisionComponent Name = "SplineComp">
            <Events>
                <BeginComponent>
                    <Call Func = "LoadSplineFromAsset" Target = "SplineComp">
                        <string Name = "AssetName" Value = "SP_Ring"/>
                    </Call>
                </BeginComponent>
            </Events>
        </WSplineCollisionComponent>

        <WProjectileMovementComponent Name = "ProjMoveComp">
            <Properties>
                <bool Name = "Homing" Value = "true"/>
                <float Name = "HomingTurnLimit" Value = "360"/>
                <float Name = "Speed" Value = "10"/>
                <float Name = "LifeSpan" Value = "10"/>
            </Properties>
        </WProjectileMovementComponent>
    </Components>

    <Events>
        <BeginPlay>
            <Call Func = "SetSmartHoming" Target = "this">
                <bool Name = "SmartHoming" Value = "true"/>
                <float Name = "Range" Value = "20"/>
            </Call>

            <Call Func = "GenerateCapsuleCollision" Target = "SplineComp">
                <int Name = "Segment" Value = "8"/>
                <bool Name = "UseBoundingBox" Value = "true"/>
            </Call>

        </BeginPlay>

        <OnHit>
            <Call Func = "Destroy" Target = "this"/>
        </OnHit>
    </Events>


</AProjectileBase>
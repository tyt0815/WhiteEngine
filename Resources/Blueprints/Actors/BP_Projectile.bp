<AProjectileBase>
    <Properties>
    </Properties>

    <Components>
        <WStaticMeshComponent Name = "StaticMeshComponent">
            <Events>
                <BeginComponent>

                    <Call Func = "SetStaticMesh" Target = "StaticMeshComponent">
                        <string Name = "StaticMesh" Value = "SM_MetalRing"/>
                    </Call>

                </BeginComponent>
            </Events>
        </WStaticMeshComponent>

        <WStaticMeshComponent Name = "StaticMeshComponent2">
            <Events>
                <BeginComponent>

                    <Call Func = "SetStaticMesh" Target = "StaticMeshComponent2">
                        <string Name = "StaticMesh" Value = "SM_LaminateFlooringBrownBox"/>
                    </Call>

                </BeginComponent>
            </Events>
        </WStaticMeshComponent>

        <WObjectAnimComponent Name = "ObjectAnimComp">
            <Events>
                <BeginComponent>
                    <Call Func = "LoadAnimation" Target = "ObjectAnimComp">
                        <string Name ="AssetName" Value = "OA_MissileTrack"/>
                        <string Name = "AnimName" Value = "Proj1"/>
                    </Call>

                    <Call Func = "SetTargetComponent" Target = "ObjectAnimComp">
                        <Call Func = "Get" Target = "StaticMeshComponent2" Name = "Component"/>
                    </Call>

                    <Call Func = "Play" Target = "ObjectAnimComp">
                        <bool Name = "Loop" Value = "true"/>
                        <string Name = "Loc" Value = "XYZ"/>
                    </Call>

                </BeginComponent>
            </Events>
        </WObjectAnimComponent>

    </Components>


</AProjectileBase>
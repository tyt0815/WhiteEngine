<AProjectileBase>
    <Properties>
    </Properties>

    <Components>
        <WStaticMeshComponent Name = "StaticMeshComponent">
            <Events>
                <BeginComponent>
                    <function Target = "this" Name = "SetupAttachment">
                        <string Name = "Parent" Value = "RootComponent"/>
                    </function>
                    <function Target = "this" Name = "SetStaticMesh">
                        <string Name = "StaticMesh" Value = "SM_MetalRing"/>
                    </function>
                </BeginComponent>
            </Events>
        </WStaticMeshComponent>

        <BP_ProjectileMovementComponent Name = "ProjMovementComp2">
            <Properties>
                <bool Name = "Homing" Value = "false" />
                <float Name = "LifeSpan" Value = "10"/>
            </Properties>
        </BP_ProjectileMovementComponent>
    </Components>


</AProjectileBase>
<AActor>
    <Properties>
    </Properties>

    <Components>
        <WStaticMeshComponent Name = "StaticMeshComponent">
            <Events>
                <BeginPlay>
                    <function Target = "this" Name = "SetStaticMesh" StaticMesh = "SM_MetalRing"/>
                </BeginPlay>
            </Events>
        </WStaticMeshComponent>

        <BP_ProjectileMovementComponent Name = "ProjMovementComp2">
            <Properties>
                <bool Name = "Homing" Value = "false" />
                <float Name = "LifeSpan" Value = "2.5"/>
            </Properties>
        </BP_ProjectileMovementComponent>
    </Components>


</AActor>
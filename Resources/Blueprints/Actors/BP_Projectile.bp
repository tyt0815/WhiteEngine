<AProjectileBase>
    <Properties>
    </Properties>

    <Components>
        <WStaticMeshComponent Name = "StaticMeshComponent">
            <Events>
                <BeginComponent>
                
                    <Call Func = "SetupAttachment" Target = "StaticMeshComponent">
                        <Call Func = "GetRootComponent" Target = "this" Name = "Parent"/>
                    </Call>

                    <Call Func = "SetStaticMesh" Target = "StaticMeshComponent">
                        <string Name = "StaticMesh" Value = "SM_MetalRing"/>
                    </Call>

                </BeginComponent>
            </Events>
        </WStaticMeshComponent>

        <BP_ProjectileMovementComponent Name = "ProjMovementComp2">
            <Properties>
                <bool Name = "Homing" Value = "false" />
                <float Name = "LifeSpan" Value = "10"/>
            </Properties>
        </BP_ProjectileMovementComponent>
    </Components>


</AProjectileBase>
                    </Call>

                </BeginComponent>
            </Events>
        </WObjectAnimComponent> -->

    </Components>

    <Events>
        <BeginPlay>
            <Call Func = "SetSmartHoming" Target = "this">
                <bool Name = "SmartHoming" Value = "true"/>
                <float Name = "Range" Value = "5"/>
            </Call>
        </BeginPlay>
    </Events>


</AProjectileBase>
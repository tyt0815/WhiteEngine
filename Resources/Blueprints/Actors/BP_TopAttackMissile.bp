<ATopAttackMissile>
    <Properties>
        <float Name = "MinArrivalThresholdSq" Value = "64"/>
        <float Name = "MaxArrivalThresholdSq" Value = "100"/>
        <float Name = "MinRotationZStep" Value = "-45"/>
        <float Name = "MaxRotationZStep" Value = "45"/>
    </Properties>

    <Variables>
        <string Name = "SM" Value = "SM_MetalRing"/>

        <array_string Name = "Test">
            <string Value = "a"/>
        </array_string>
    </Variables>

    <Components>
        <WStaticMeshComponent Name = "StaticMeshComp">
            <Events>
                <BeginComponent>
                    <Call Func = "SetStaticMesh" Target = "StaticMeshComp">
                        <string Name = "StaticMesh" Target = "this" Value = "SM"/>
                    </Call>
                </BeginComponent>
            </Events>
        </WStaticMeshComponent>

        <WProjectileMovementComponent Name = "ProjMovementComp">
            <Properties>
                <float Name = "Speed" Value = "30"/>
            </Properties>
        </WProjectileMovementComponent>
    </Components>

    <Events>
        <BeginPlay>
            <Call Func = "SpawnActor" Target = "this">
                <string Name = "Class" Value = "BP_Projectile"/>
                <!-- <float3 Name = "Location" Value = "(1, 1, 1)"/> -->
                <!-- <Call Func = "GetActorLocation" Name = "Location" Target = "this"/> -->
                <Call Func = "GetActorTransform" Name = "Transform" Target = "this"/>
            </Call>
        </BeginPlay>
    </Events>

</ATopAttackMissile>

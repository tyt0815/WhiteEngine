<AStateMachineActor>
    <Components>
        <Movement Name = "ProjMove" InitSpeed = "{0, 0, 0}" MaxSpeed = "10" LifeSpan = "20">
            <Mesh Name = "Mesh" Asset = "SM_MetalRing">
                <Collision Name = "SplineCollision" Type = "Spline" Asset = "SP_Ring" Segment = "4" BoundingBox = "true" Debug = "true"/>
            </Mesh>
        </Movement>
        <Spline Name = "LaunchSpline" Asset = "SP_RingProjPath"/>
    </Components>

    <StateMachine Initial = "Launch">
        <State Name = "Global">
            <OnDeactivate_SplineCollision>
                <Log Content = "BP_RingProj: Destroy"/>
                <Destroy/>
            </OnDeactivate_SplineCollision>
        </State>

        <State Name = "Launch" Base = "Global">
            <OnEnter>
                <FollowSpline Spline = "LaunchSpline" Target = "ProjMove" SpeedRate = "$ProjMove.MaxSpeed"/>
            </OnEnter>

            <OnFollowSplineEnd_LaunchSpline>
                <ChangeState Name = "Flying"/>
            </OnFollowSplineEnd_LaunchSpline>
        </State>

        <State Name = "Flying" Base = "Global">
            <OnEnter>
                <Set Name = "ProjMove.Acceleration" Value = "1000"/>
            </OnEnter>
        </State>
    </StateMachine>
</AStateMachineActor>
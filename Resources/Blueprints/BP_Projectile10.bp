<AProjectileBase>

    <Configs>
        <LifeCycle LifeSpan = "5"/>
    </Configs>

    <Components>
        <Mesh Name = "Body" Asset = "SM_MetalRing"/>
        <Spline Name = "Spline" Asset = "SP_Ring"/>
    </Components>

    <Events>

        <OnSpawn>
            <FollowSpline Target = "Body" Spline = "Spline" Loop = "true" Duration = "0.25"/>
        </OnSpawn>

    </Events>

</AProjectileBase>
<AStateMachineActor>
    <Components>
        <Movement Name = "ProjMove" InitSpeed = "{0, 0, 0}" MaxSpeed = "30" LifeSpan = "20" HomingTags = "[Enemy]">
            <Mesh Name = "Mesh" Asset = "SM_ScuffedGoldBox">
                <Collision Name = "BoxCollision" Type = "Box" Extent = "{0.5, 0.5, 0.5}" Debug = "true"/>
            </Mesh>
        </Movement>
        <Spline Name = "LaunchSpline" Asset = "SP_MissileLaunch"/>
    </Components>

    <StateMachine Initial = "Launch">
        <State Name = "Global">
            <OnHit_BoxCollision>
                <Destroy/>
            </OnHit_BoxCollision>
        </State>

        <State Name = "Launch" Base = "Global">
            
        </State>
    </StateMachine>
</AStateMachineActor>
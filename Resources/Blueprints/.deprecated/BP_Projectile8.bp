<AProjectileBase>

    <Configs>
        <LifeCycle LifeSpan = "2"/>
    </Configs>

    <Components>
        <Anim Name = "Anim">
            <Mesh Name = "Body" Asset = "SM_ScuffedGoldBox"/>
        </Anim>
    </Components>

    <Events>

        <OnSpawn>
            <PlayAnim Target = "Anim" Asset = "OA_ColdLaunch" Anim = "Projectile" Loop = "false" RootMotion = "false"/>
        </OnSpawn>

        <OnAnimStop Target = "Anim">
            <Destroy/>
        </OnAnimStop>

    </Events>

</AProjectileBase>
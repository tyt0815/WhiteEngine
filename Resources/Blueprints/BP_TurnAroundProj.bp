<AStateMachineActor>
    <Components>
        <Movement Name = "Movement" InitSpeed = "{0, 5, 10}" MaxSpeed = "30" LifeSpan = "0" HomingTags = "[Enemy]" HomingStopRange = "0.25"
        UseWaypoints = "true" Waypoints = "[{0, 0.5, 0}]" WaypointType = "Adaptive" WaypointSpace = "World">
            <Mesh Name = "Mesh" Asset = "SM_ScuffedGoldBox">
                <Collision Name = "BoxCollision" Type = "Box" Extent = "{0.5, 0.5, 0.5}" Debug = "true"/>
            </Mesh>
        </Movement>
    </Components>   

    <StateMachine Initial = "Launch">

        <State Name = "Global">

            <OnHit_BoxCollision>
                <Destroy/>
            </OnHit_BoxCollision>

            <OnSpawn>
                <Register Name = "InitRotation" Value = "Movement.GetWorldRotation()"/>
            </OnSpawn>

        </State>

        <State Name = "Launch" Base = "Global">
            <OnEnter>
                 <Timer Time = "1" Loop = "false" Call = "ToIdleState"/>
            </OnEnter>
            
            <ToIdleState>
                <ChangeState Name = "Idle"/>
            </ToIdleState>
        </State>

        <State Name = "Idle" Base = "Global">
            <Transitions>
                <Transition Event = "OnHomingSuccess_Movement" Target = "Homing"/>
            </Transitions>
            
            <OnEnter>
                <SetWorldRotation Target = "Movement" Rot = "$InitRotation"/>
                <Set Name = "Movement.Velocity" Value = "{-30, 0, 0}"/>
                <Set Name = "Movement.MaxSpeed" Value = "30"/>
                <Set Name = "Movement.HomingStrategy" Value = "Nearest"/>
            </OnEnter>

            <OnUpdate>
                <AddForce Target = "Movement" Force = "Movement.GetWorldRight() * (100 * $DeltaTime)"/>
                <Set Name = "Movement.HomingRange" Value = "$Movement.HomingRange + (1 * $DeltaTime)"/>
            </OnUpdate>
        </State>

        <State Name = "Homing" Base = "Global">
            <OnEnter>
                <Set Name = "Movement.MaxSpeed" Value = "5"/>
                <Set Name = "Movement.LifeSpan" Value = "0"/>

                <SpawnProjectile Name = "BP_TurnAroundProj" Interval = "0.1" Count = "4" Strategy = "Line" Range = "1" Loc = "{0, 10, 0}" Rot = "{0, 0, 0}">
                    <Set Name = "Movement.MaxSpeed" Value = "0.1"/>
                    <SetHomingTarget Source = "Owner.Movement" Target = "Movement"/>
                </SpawnProjectile>
            </OnEnter>
        </State>

    </StateMachine>

</AStateMachineActor>

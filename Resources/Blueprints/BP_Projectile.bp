<AProjectileBase InitSpeed = "(0, 0, 0)" Life = "10" Homing = "100" HomingTurnLimit = "360" GravityScale = "0">
    
    <Components>
        <Mesh Name = "Body" Asset = "SM_MetalRing" Loc = "(0, -2, 0)">
            <Mesh Name = "SubMesh" Asset = "SM_ScuffedGoldBox" Loc = "(0, 1, 0)"/>
            <Spline Name = "Spline" Asset = "SP_Ring" Loc = "(1, 0, 0)" Anim = "true"/>
        </Mesh>
    </Components>

    <Events>
        <OnSpawn>
            <Event Name = "CustomEvent"/>
            <Animation Asset = "OA_ColdLaunch" Anim = "Projectile" Target = "Spline" Loop = "true" Loc = "Y"/>
        </OnSpawn>

        <CustomEvent>
            <Particle Asset = "P_Explosion"/>
        </CustomEvent>
    </Events>

</AProjectileBase>
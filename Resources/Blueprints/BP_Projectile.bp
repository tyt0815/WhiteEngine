<Blueprint Parent="AProjectileBase">
    <Properties>
        <float Name = "Value" Value = "1000.0" />
        <bool Name = "Boolean" Value = "True" />
    </Properties>

    <Components>
        <WStaticMeshComponent Name = "StaticMeshComponent">
            <Properties>

            </Properties>
            <Initializers>
                <StaticMesh>SM_MetalRing</StaticMesh>
            </Initializers>
        </WStaticMeshComponent>
        <WStaticMeshComponent Name = "StaticMeshComponent2">
            <Properties>

            </Properties>
            <Initializers>
                <StaticMesh>SM_LaminateFlooringBrownBox</StaticMesh>
                <ParentComponent>StaticMeshComponent</ParentComponent>
            </Initializers>
        </WStaticMeshComponent>
        <WProjectileMovementComponent Name = "ProjMovementComp">
            <Properties>
                <bool Name = "Homing" Value = "true" />
                <float Name = "LifeSpan" Value = "0"/>
            </Properties>
        </WProjectileMovementComponent>
    </Components>


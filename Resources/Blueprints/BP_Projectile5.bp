<AProjectileBase>

    <Configs>
        <Movement InitSpeed = "(0 0 20)" GravityScale = "0" MaxSpeed = "1000"/>

        <LifeCycle Life = "5" />

        <Homing Strategy = "Angle" Range = "200" Angle = "90" TurnRate = "180" TargetTags = "[Enemy]" />
    </Configs>

    <Components>
        <Mesh Name = "Body" Asset = "SM_LaminateFlooringBrownBox">
            <Collision Name = "BoxCollision" Type = "Box" Extent = "(0.5 0.5 0.5)" Damage = "250" Delay = "0.5" TargetTags = "Enemy"/>
        </Mesh>
    </Components>

    <Events>
        <OnHit>
            <Destroy/>
        </OnHit>
    </Events>

</AProjectileBase>
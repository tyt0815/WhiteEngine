<AProjectileBase>

    <Configs>
    </Configs>

    <Components>    
        <Movement Name = "Movement" OrientToMovement = "true" InitSpeed = "{0, 5, 10}" GravityScale = "1" MaxSpeed = "1000" 
        HomingStrategy = "None" HomingRange = "20" HomingTurnRate = "90" HomingTags = "[Alliance]"
        ShouldBounce = "true" Bounciness = "1"
        >
            <Mesh Name = "Mesh" Asset = "SM_ScuffedGoldBox" Scale = "{0.5, 0.5, 1}">
                <Collision Name = "BoxCollision" Type = "Box" MaxHit = "0"
                    Extent = "{0.5, 0.5, 0.5}" Damage = "250" Delay = "0.1" Debug = "true" Interval = "0"/>
            </Mesh>
        </Movement>
    </Components>

    <Events>

        <OnSpawn>
            <BindCollision Movement = "Movement" Collision = "BoxCollision"/>
        </OnSpawn>

        <OnHit Target = "BoxCollision" Filter = "[Alliance, Enemy]">
            <Deactivate Target = "Movement" WithChild = "true"/>
        </OnHit>

        <OnBounce Target = "Movement">
            <Particle Loc = "$ImpactPoint" Asset = "P_Explosion_Green_Tiny"/>
        </OnBounce>
    </Events>

</AProjectileBase>
<AProjectileBase>

    <Configs>
        <Movement InitSpeed = "(0 0 20)" GravityScale = "0" MaxSpeed = "1000"/>
        <LifeCycle Life = "5" />

        <Homing Strategy = "Nearest" Range = "100" TurnRate = "360" TargetTags = "[Alliance]" StopRange = "5"
            UseWaypoints = "true" Space = "World" Type = "Adaptive" Waypoints = "[(0 0.5 -0.5)]"
        />
    </Configs>

    <Components>
        <Mesh Name = "Body" Asset = "SM_ScuffedGoldBox">
            <Collision Name = "BoxCollision" Type = "Box" 
                Extent = "(1 1 1)" Damage = "250" Delay = "0.5" TargetTags = "Alliance"/>
        </Mesh>
    </Components>

    <Events>
        <OnHit>
            <Destroy/>
        </OnHit>
    </Events>

</AProjectileBase>
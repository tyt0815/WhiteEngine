<AProjectileBase>

    <Configs>
    </Configs>

    <Components>
        <Movement Name = "Movement" InitSpeed = "{0, 0, 20}" GravityScale = "0" MaxSpeed = "1000" LifeSpan = "5"
            HomingStrategy = "None" HomingRange = "200" HomingAngle = "90" HomingTurnRate = "45" HomingTags = "[Enemy]">
            <Mesh Name = "Body" Asset = "SM_LaminateFlooringBrownBox">
                <Collision Name = "BoxCollision" Type = "Box" Extent = "{0.5, 0.5, 0.5}" Damage = "250" Delay = "0.5" TargetTags = "Enemy"/>
            </Mesh>
        </Movement>
    </Components>

    <Events>
        <OnHit>
            <Destroy/>
        </OnHit>

        <OnTime Time = "1">
            <Set Name = "Movement.HomingStrategy" Value = "Nearest"/>
            <SetWorldLocation Target = "Movement" Loc = "Movement.GetWorldLocation() + {0, 5, 0}"/>  
        </OnTime>

        <OnHomingFail Target = "Movement">
            <Destroy/>
        </OnHomingFail>
    </Events>

</AProjectileBase>
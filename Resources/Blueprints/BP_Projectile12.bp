<AProjectileBase>

    <Configs>
        <LifeCycle LifeSpan = "5"/>
    </Configs>

    <Components>
        <Movement Name = "Movement" InitSpeed = "{0, 0, 20}" GravityScale = "0" MaxSpeed = "1000"
            HomingStrategy = "Nearest" HomingRange = "1" HomingAngle = "90" HomingTurnRate = "45" HomingTags = "[Enemy]">
            <Mesh Name = "Body" Asset = "SM_LaminateFlooringBrownBox">
                <Collision Name = "BoxCollision" Type = "Box" Extent = "{0.5, 0.5, 0.5}" Damage = "250" Delay = "0.5" TargetTags = "Enemy"/>
            </Mesh>
        </Movement>
    </Components>

    <Events>
        <OnSpawn>
            <Timer Time = "1" Event = "Timer1" Loop = "true"/>
        </OnSpawn>

        <Timer1>
            <SetWorldLocation Target = "Movement" Loc = "Movement.GetWorldLocation() + {0, 5, 0}"/>  
        </Timer1>
        
    </Events>

</AProjectileBase>
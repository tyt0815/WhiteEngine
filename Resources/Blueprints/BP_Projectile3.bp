<AProjectileBase>

    <Configs>
        
    </Configs>

    <Components>
        <Movement Name = "Movement" InitSpeed = "{0, 10, 20}" GravityScale = "1" MaxSpeed = "1000" LifeSpan = "5">
            <Mesh Name = "Body" Asset = "SM_MetalRing">
                <Collision Name = "SplineCollision" Type = "Spline" Delay = "0.1" MaxHit = "1" Asset = "SP_Ring" Segment = "8" BoundingBox = "true"/>
                <Collision Name = "BoxCollision" Loc = "{0, 10, 0}" Type = "Box" Extent = "{1, 1, 1}"/>
            </Mesh>
        </Movement>
    </Components>

    <Events>
        <OnHit>
            <Particle Loc = "Movement.GetWorldLocation()" Asset = "P_Explosion_Red_Small"/>
        </OnHit>

        <OnHit Target = "BoxCollision">
            <Destroy/>
        </OnHit>

        <OnTime Time = "0.5">
            <Deactivate Target = "Body" WithChild = "true"/>
        </OnTime>
        <OnTime Time = "0.75">
            <Activate Target = "Body" WithChild = "true"/>
        </OnTime>

        <OnActivate Target = "Body">
            <Particle Loc = "Movement.GetWorldLocation()" Asset = "P_Explosion_Blue"/>
        </OnActivate>
    </Events>

</AProjectileBase>
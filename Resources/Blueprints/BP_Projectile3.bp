<AProjectileBase>

    <Configs>
        
    </Configs>

    <Components>
        <Movement Name = "Movement" InitSpeed = "{0, 10, 20}" GravityScale = "1" MaxSpeed = "1000" LifeSpan = "5">
            <Collision Name = "SplineCollision" Debug = "true" Type = "Spline" Delay = "0.1" MaxHit = "1" Asset = "SP_Ring" Segment = "8" BoundingBox = "true">
                <Mesh Name = "Body" Asset = "SM_MetalRing"/>
            </Collision>
        </Movement>
    </Components>

    <Events>
        <OnSpawn>
            <Event Name = "BlinkStart"/>
        </OnSpawn>

        <OnHit>
            <Destroy/>
        </OnHit>

        <BlinkStart>
            <Deactivate Target = "Body" WithChild = "true"/>
            <Timer Time = "0.2" Event = "BlinkEnd"/>
        </BlinkStart>

        <BlinkEnd>
            <Activate Target = "Body" WithChild = "true"/>
            <Timer Time = "0.2" Event = "BlinkStart"/>
        </BlinkEnd>

        <OnActivate Target = "Body">
            <!-- <Particle Loc = "Movement.GetWorldLocation()" Asset = "P_Explosion_Red_Small"/> -->
        </OnActivate>
    </Events>

</AProjectileBase>
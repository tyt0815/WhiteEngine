<AProjectileBase>

    <Configs>
        <Movement InitSpeed = "(0, 10, 20)" GravityScale = "1" MaxSpeed = "1000"/>
        <LifeCycle Life = "5" />
    </Configs>

    <Components>
        <Mesh Name = "Body" Asset = "SM_MetalRing">
            <Collision Name = "SplineCollision" Type = "Spline" Asset = "SP_Ring" Activate = "true" Segment = "8" BoundingBox = "true"/>
            <Collision Name = "BoxCollision" Loc = "(0, 10, 0)" Type = "Box" Extent = "(1, 1, 1)" Activate = "true"/>
        </Mesh>
    </Components>

    <Events>
        <OnHit>
            <Particle Asset = "P_Explosion_Red_Small"/>
        </OnHit>

        <OnHit Target = "BoxCollision">
            <Destroy/>
        </OnHit>

        <OnTime Time = "0.75">
            <Particle Asset = "P_Explosion_Red_Small"/>
        </OnTime>
        <OnTime Time = "1.5">
            <Particle Asset = "P_Explosion_Blue"/>
        </OnTime>
    </Events>

</AProjectileBase>
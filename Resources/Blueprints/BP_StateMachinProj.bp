<AStateMachineActor>
    <Components>
        <Mesh Name = "Body" Asset = "SM_ScuffedGoldBox">
            <Mesh Name = "Body2" Asset = "SM_ScuffedGoldBox"/>
        </Mesh>
        <!-- <Movement Name = "Movement" InitSpeed = "{0, 0, 10}" GravityScale = "0" MaxSpeed = "10" LifeSpan = "5">
            
        </Movement> -->
    </Components>

    <StateMachine Initial = "State1">        
        <State Name = "BaseState">
            <OnEnter>
                <Log Content = "Spawn::OnEnter"/>
            </OnEnter>

            <OnSpawn>
                <Log Content = "BaseState::OnSpawn"/>
            </OnSpawn>

            <Custom1>
                <Log Content = "BaseState::Custom1"/>
            </Custom1>
        </State>

        <State Name = "State1" Base = "BaseState">
            <OnSpawn>
                <Call Target = "BaseState.OnSpawn"/>
                <Log Content = "State1::OnSpawn"/>
            </OnSpawn>

            <Custom1>
                <Log Content = "BaseState::Custom1"/>
            </Custom1>
        </State>


        <State Name = "State2" Base = "BaseState">
            <OnDestroy>
                <Call Target = "Custom1"/>
            </OnDestroy>
        </State>

    </StateMachine>

</AStateMachineActor>
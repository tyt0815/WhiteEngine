<AStateMachineActor>
    <Components>
        <Spline Name = "SplineRing" Asset = "SP_Ring">
            <Mesh Name = "Body" Asset = "SM_ScuffedGoldBox">
                <Mesh Name = "Body2" Asset = "SM_ScuffedGoldBox"/>
            </Mesh>
        </Spline>
    </Components>

    <StateMachine Initial = "State1">        
        <State Name = "BaseState">
            <OnEnter>
                <Log Content = "BaseState::OnEnter"/>
            </OnEnter>

            <OnSpawn>
                <Log Content = "BaseState::OnSpawn"/>
                <FollowSpline Spline = "SplineRing" Target = "Body" Loop = "true"/>
            </OnSpawn>

            <Custom1>
                <Log Content = "BaseState::Custom1"/>
            </Custom1>
        </State>

        <State Name = "State1" Base = "BaseState">
            <OnSpawn>
                <Call Target = "BaseState.OnSpawn"/>
                <Log Content = "State1::OnSpawn"/>
                <Timer Time = "0.5" Loop = "true" Call = "Custom1"/>
                <Transition Name = "BaseState"/>
            </OnSpawn>

            <Custom1>
                <Log Content = "State1::Custom1"/>
            </Custom1>

            <OnActivate_Body>
                <Log Content = "State1::OnActivate_Body"/>
            </OnActivate_Body>
        </State>


        <State Name = "State2" Base = "BaseState">
            <OnDestroy>
                <Call Target = "Custom1"/>
            </OnDestroy>
        </State>

    </StateMachine>

</AStateMachineActor>